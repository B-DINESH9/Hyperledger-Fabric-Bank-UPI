# Blockchain UPI System - Backend Environment Variables

# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Hyperledger Fabric Configuration
FABRIC_NETWORK_CONFIG_PATH=../blockchain-network/connection-profile.json
FABRIC_WALLET_PATH=./wallet

# Database Configuration (if using external database)
# DATABASE_URL=mongodb://localhost:27017/blockchain-upi

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_SALT_ROUNDS=10
SESSION_SECRET=your-session-secret-key

# Blockchain Network URLs
ORDERER_URL=grpc://localhost:7050
PEER_BANK1_URL=grpc://localhost:7051
PEER_BANK2_URL=grpc://localhost:8051
PEER_NPCI_URL=grpc://localhost:9051

# CouchDB URLs
COUCHDB_BANK1_URL=http://localhost:5984
COUCHDB_BANK2_URL=http://localhost:6984
COUCHDB_NPCI_URL=http://localhost:7984
